# Local environment template. Copy it once and edit your copy:
#
#     cp .env.example .env
#
# `.env` is git-ignored; this template is the committed reference. It holds no
# secrets. Load it explicitly for scripts and notebooks from the repository root:
#
#     uv run --env-file .env --group notebook --group tracking \
#       marimo edit notebooks/02_model_fitting.py
#
# Relative paths below resolve against the working directory, so run commands
# from the repository root.

# Makes the `src/` packages importable. macOS can hide this checkout's
# editable-install `.pth` files, so plain `uv run` cannot import them otherwise.
PYTHONPATH=src

# A local scratch MLflow store (git-ignored). Never point these at the
# canonical `mlflow.db` / `mlartifacts/`, which hold the one-time final
# evaluation evidence. MLflow creates the directory on first use.
MLFLOW_TRACKING_URI=sqlite:///.mlflow-local/mlflow.db
MLFLOW_EXPERIMENT_NAME=age-group-local
AGE_GROUP_MLFLOW_ARTIFACT_LOCATION=.mlflow-local/mlartifacts

# Suppresses MLflow's interactive agent hint in logs.
MLFLOW_DISABLE_AGENT_HINT=1
